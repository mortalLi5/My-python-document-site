{"config":{"lang":["zh","en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Susu\u7684 Python \u5b66\u4e60\u7b14\u8bb0","text":"<p>\u6b22\u8fce\u6765\u5230\u6211\u7684 Python \u5b66\u4e60\u7b14\u8bb0\u7ad9\u3002\u8fd9\u91cc\u8bb0\u5f55\u4e86\u6211\u4ece\u96f6\u5f00\u59cb\u5b66\u4e60python\u7684\u6240\u6709\u5185\u5bb9\uff0c\u5305\u62ec\u77e5\u8bc6\u70b9\u7684\u603b\u7ed3\uff0c\u8fd8\u6709\u4e00\u4e9b\u4ee3\u7801\u7684\u79ef\u7d2f\u3001\u8e29\u5751\u6848\u4f8b\uff0c\u5e0c\u671b\u80fd\u5e2e\u52a9\u5230\u4f60\u3002</p>"},{"location":"#_1","title":"\u672c\u6587\u8981\u70b9","text":"<ul> <li>\u9002\u5408 Python \u521d\u5b66\u8005\u590d\u4e60\u57fa\u7840\u8bed\u6cd5</li> <li>\u5305\u542b\u5e38\u7528\u4ee3\u7801\u7247\u6bb5\u548c\u5b9e\u7528\u6280\u5de7</li> <li>\u6301\u7eed\u66f4\u65b0\u4e2d</li> </ul>"},{"location":"#_2","title":"\u76ee\u5f55","text":"<ol> <li>[\u5b66\u4e60python\u4e4b\u524d]</li> <li>Python \u57fa\u7840\u8bed\u6cd5</li> <li>Python \u5b9e\u7528\u6280\u5de7</li> <li>\u5e38\u89c1\u95ee\u9898</li> </ol>"},{"location":"#_3","title":"\u4e3a\u4ec0\u4e48\u5199\u8fd9\u4e2a\u7b14\u8bb0","text":"<p>\u5b66\u4e60\u5efa\u8bae</p> <p>\u5b66\u7f16\u7a0b\u6700\u91cd\u8981\u7684\u662f\u591a\u52a8\u624b\u5199\u4ee3\u7801\uff0c\u9047\u5230\u95ee\u9898\u5148\u81ea\u5df1\u67e5\u6587\u6863\uff0c\u518d\u8bb0\u5f55\u4e0b\u6765\uff0c\u8fd9\u6837\u5370\u8c61\u6700\u6df1\u523b\u3002</p> <p>Python \u8bed\u6cd5\u76f8\u5bf9\u7b80\u5355\uff0c\u4f46\u7ec6\u8282\u5f88\u591a\u3002\u901a\u8fc7\u6574\u7406\u7b14\u8bb0\uff0c\u53ef\u4ee5\u628a\u96f6\u6563\u7684\u77e5\u8bc6\u70b9\u4e32\u8d77\u6765\uff0c\u65b9\u4fbf\u4ee5\u540e\u590d\u4e60\u548c\u67e5\u9605\u3002</p>"},{"location":"faq/","title":"\u5e38\u89c1\u95ee\u9898","text":""},{"location":"faq/#python-python3","title":"Python \u548c Python3 \u6709\u4ec0\u4e48\u533a\u522b\uff1f","text":"<p>\u5728 macOS \u548c Linux \u4e0a\uff0c<code>python</code> \u6709\u65f6\u6307\u5411 Python 2\uff0c\u800c <code>python3</code> \u6307\u5411 Python 3\u3002\u5efa\u8bae\u7edf\u4e00\u4f7f\u7528 <code>python3</code>\u3002</p>"},{"location":"faq/#_2","title":"\u600e\u4e48\u5b89\u88c5\u7b2c\u4e09\u65b9\u5e93\uff1f","text":"<p>\u4f7f\u7528 pip\uff1a</p> <pre><code>pip install \u5e93\u540d\n</code></pre> <p>\u4f8b\u5982\u5b89\u88c5 requests\uff1a</p> <pre><code>pip install requests\n</code></pre>"},{"location":"faq/#python","title":"\u8fd0\u884c Python \u6587\u4ef6\u62a5\u8bed\u6cd5\u9519\u8bef\u600e\u4e48\u529e\uff1f","text":"<p>\u6392\u67e5\u6b65\u9aa4</p> <ol> <li>\u68c0\u67e5\u662f\u5426\u6709\u4e2d\u6587\u6807\u70b9\u7b26\u53f7\uff0c\u6bd4\u5982\u4e2d\u6587\u62ec\u53f7\u3001\u5f15\u53f7\u3002</li> <li>\u68c0\u67e5\u7f29\u8fdb\u662f\u5426\u4e00\u81f4\uff0c\u4e0d\u8981\u6df7\u7528\u7a7a\u683c\u548c Tab\u3002</li> <li>\u68c0\u67e5 Python \u7248\u672c\uff0c\u6709\u4e9b\u8bed\u6cd5\u9700\u8981 Python 3.6 \u4ee5\u4e0a\u3002</li> </ol>"},{"location":"faq/#_3","title":"\u63a8\u8350\u7684\u5b66\u4e60\u8d44\u6e90","text":"<ul> <li>Python \u5b98\u65b9\u6587\u6863</li> <li>\u5ed6\u96ea\u5cf0 Python \u6559\u7a0b</li> </ul>"},{"location":"python-basics/","title":"Python \u57fa\u7840\u8bed\u6cd5\u76ee\u5f55","text":"<ol> <li>\u53d8\u91cf\u548c\u6570\u636e\u7c7b\u578b </li> <li>\u6761\u4ef6\u5224\u65ad</li> <li>\u5faa\u73af</li> <li>for \u5faa\u73af</li> <li>while \u5faa\u73af</li> <li>\u51fd\u6570</li> <li>\u5217\u8868\u548c\u5b57\u5178</li> </ol>"},{"location":"python-tips/","title":"Python \u5b9e\u7528\u6280\u5de7","text":""},{"location":"python-tips/#_1","title":"\u5217\u8868\u63a8\u5bfc\u5f0f","text":"<p>\u7528\u4e00\u884c\u4ee3\u7801\u751f\u6210\u5217\u8868\uff1a</p> <pre><code>squares = [x**2 for x in range(10)]\nprint(squares)\n# [0, 1, 4, 9, 16, 25, 36, 49, 64, 81]\n</code></pre>"},{"location":"python-tips/#_2","title":"\u4ea4\u6362\u53d8\u91cf","text":"<p>\u4e0d\u9700\u8981\u4e34\u65f6\u53d8\u91cf\uff1a</p> <pre><code>a, b = 1, 2\na, b = b, a\nprint(a, b)  # 2 1\n</code></pre>"},{"location":"python-tips/#_3","title":"\u5b57\u7b26\u4e32\u683c\u5f0f\u5316","text":"<p>\u63a8\u8350\u7528 f-string\uff1a</p> <pre><code>name = \"Python\"\nversion = 3.12\nprint(f\"{name} \u7684\u7248\u672c\u662f {version}\")\n</code></pre>"},{"location":"python-tips/#_4","title":"\u8bfb\u53d6\u6587\u4ef6","text":"<p>\u4f7f\u7528 <code>with</code> \u8bed\u53e5\u53ef\u4ee5\u81ea\u52a8\u5173\u95ed\u6587\u4ef6\uff1a</p> <pre><code>with open(\"example.txt\", \"r\", encoding=\"utf-8\") as f:\n    content = f.read()\n    print(content)\n</code></pre>"},{"location":"python-tips/#_5","title":"\u5e38\u7528\u5185\u7f6e\u51fd\u6570","text":"\u51fd\u6570 \u4f5c\u7528 <code>len()</code> \u83b7\u53d6\u957f\u5ea6 <code>type()</code> \u67e5\u770b\u6570\u636e\u7c7b\u578b <code>range()</code> \u751f\u6210\u6574\u6570\u5e8f\u5217 <code>enumerate()</code> \u540c\u65f6\u83b7\u53d6\u7d22\u5f15\u548c\u503c <code>zip()</code> \u5408\u5e76\u591a\u4e2a\u5e8f\u5217 <p>\u6ce8\u610f</p> <p>\u4f7f\u7528 <code>open()</code> \u65f6\u5efa\u8bae\u52a0\u4e0a <code>encoding=\"utf-8\"</code>\uff0c\u907f\u514d\u4e2d\u6587\u4e71\u7801\u3002</p>"},{"location":"variety-and-data/","title":"Variety and data","text":""},{"location":"variety-and-data/#_1","title":"\u53d8\u91cf","text":"<p>\u4f8b\u5b50</p> <p>A = \"xiaomin\"</p> <p>print(A)</p>"}]}